# /srv/monbronze/shared/.env.production : variables du site EN PRODUCTION. Lues par systemd
# (EnvironmentFile) à l'exécution ET par le build sur le VPS (NEXT_PUBLIC_*, S3_BUCKET).
# Droits 600, propriétaire monbronze. Jamais dans git.
# Après modification : NEXT_PUBLIC_* ou S3_BUCKET → reconstruire
#   (sudo -u monbronze /srv/monbronze/bin/build-release) ; le reste → sudo systemctl restart monbronze

NEXT_PUBLIC_SITE_URL=https://monbronze.fr

# Contenu et médias modifiés depuis l'espace d'administration (hors des versions déployées)
CONTENT_DIR=/srv/monbronze/shared/content
MEDIA_DIR=/srv/monbronze/shared/media

# Espace d'administration (/admin). setup-vps.sh remplit ADMIN_SESSION_SECRET et
# ADMIN_SETUP_CODE : ce code permet de choisir le mot de passe dans le navigateur, à la première
# connexion. ADMIN_PASSWORD_HASH (facultatif) : empreinte produite par
# « node scripts/admin-password.mjs », prioritaire sur le mot de passe choisi en ligne.
ADMIN_PASSWORD_HASH=
ADMIN_SESSION_SECRET=
ADMIN_SETUP_CODE=

# HTTPS automatique (Let's Encrypt) : adresse qui reçoit les avis (facultative)
LETSENCRYPT_EMAIL=
CONTACT_TO_EMAIL=contact@monbronze.fr

# Resend (e-mails). Domaine monbronze.fr vérifié chez Resend (SPF, DKIM, DMARC).
RESEND_API_KEY=
RESEND_FROM_EMAIL="monbronze.fr <contact@monbronze.fr>"

# Cloudflare Turnstile : les DEUX clés vont ensemble (publique = widget, secrète = vérification)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# OVHcloud Object Storage (conteneur PRIVÉ des pièces jointes), utilisateur S3 dédié
S3_ENDPOINT=https://s3.gra.io.cloud.ovh.net
S3_REGION=gra
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
