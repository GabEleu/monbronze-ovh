# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# monbronze
# fichiers sources lourds (scans, HDR, sons bruts) : jamais dans le dépôt
/raw/*
!/raw/.gitkeep
# exemple de configuration documenté (les vrais secrets restent dans .env.local)
!.env.example
# playwright et audits
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/screenshots/
/reports/
# médias bruts fournis par l'utilisateur (photos, vidéos d'atelier) : jamais dans le dépôt
/OneDrive_*

# Contenu et médias modifiés depuis /admin en développement (en production : CONTENT_DIR, MEDIA_DIR)
/.content/
/.media/

# Archives à transmettre (produites à la demande, jamais versionnées)
/livraison/
