# ─────────────────────────────────────────────────────────────
# monbronze.fr : variables d'environnement
# Copier ce fichier en .env.local et remplir les valeurs.
# AUCUNE clé n'est nécessaire en local : sans clé, le formulaire
# passe en mode simulé (aucun envoi, journal dans la console).
# ─────────────────────────────────────────────────────────────

# URL publique du site (canoniques, sitemap, images de partage)
NEXT_PUBLIC_SITE_URL=https://monbronze.fr

# Adresse qui reçoit les demandes de projet
CONTACT_TO_EMAIL=contact@monbronze.fr

# Resend (envoi des e-mails), https://resend.com
# Domaine d'envoi à vérifier chez Resend avant la mise en ligne.
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Pièces jointes : stockage PRIVÉ compatible S3 (OVHcloud Object Storage).
# Le navigateur envoie les fichiers directement au stockage (adresse signée par le site) ;
# la fonderie reçoit des liens de téléchargement valables 7 jours. Voir DEPLOIEMENT-OVH.md.
# S3_BUCKET seul suffit à afficher l'envoi de fichiers au build ; les clés servent à l'exécution.
# Exemple OVHcloud, région Gravelines : S3_ENDPOINT=https://s3.gra.io.cloud.ovh.net, S3_REGION=gra
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# 1 = adresses « https://hôte/conteneur/clé » au lieu de « https://conteneur.hôte/clé »
S3_PATH_STYLE=

# Cloudflare Turnstile (anti-spam)
# En local, utiliser les clés de test publiques de Cloudflare.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
